\u4ee3\u6570\u521d\u6b65</li> </ul>"},{"location":"algo/misc/","title":"\u6742\u9879","text":"<p>\u5f85\u8865\u5145\u3002\u8ba1\u5212\u5199\u7684\u5185\u5bb9\uff1a</p> <ul> <li>Barrett \u53d6\u6a21\u4f18\u5316</li> <li>\u4e8c\u5206\u7b54\u6848\u7684\u4e24\u79cd\u5199\u6cd5</li> <li>\u5bf9\u62cd / \u9020\u6570\u636e\u811a\u672c</li> <li>\u672c\u5730\u8c03\u8bd5\u6280\u5de7\uff08coredump\u3001sanitizer\uff09</li> </ul>"},{"location":"algo/string/","title":"\u5b57\u7b26\u4e32","text":"<p>\u5f85\u8865\u5145\u3002\u8ba1\u5212\u5199\u7684\u5185\u5bb9\uff1a</p> <ul> <li>\u5b57\u7b26\u4e32\u54c8\u5e0c</li> <li>KMP \u4e0e Z \u51fd\u6570</li> <li>AC \u81ea\u52a8\u673a</li> <li>\u540e\u7f00\u6570\u7ec4\uff08SA\uff09</li> <li>\u540e\u7f00\u81ea\u52a8\u673a\uff08SAM\uff09</li> </ul>"},{"location":"blog/","title":"\u968f\u7b14","text":"<p>\u4e00\u4e9b\u4e0d\u6210\u719f\u7684\u60f3\u6cd5\u3001\u6e38\u8bb0\uff0c\u548c\u5199\u7ed9\u81ea\u5df1\u770b\u7684\u4e1c\u897f\u3002</p>"},{"location":"blog/2026/10/14/%E6%96%B0%E5%8D%9A%E5%AE%A2%E5%BB%BA%E7%AB%8B%E5%95%A6/","title":"\u65b0\u535a\u5ba2\u5efa\u7acb\u5566","text":"<p>\u6298\u817e\u4e86\u4e00\u9635\uff0c\u535a\u5ba2\u7ec8\u4e8e\u4e0a\u7ebf\u4e86\u3002\u7b2c\u4e00\u7bc7\u5148\u8bf4\u8bf4\u4e3a\u4ec0\u4e48\u8981\u5199\uff0c\u4ee5\u53ca\u8fd9\u4e2a\u7ad9\u662f\u600e\u4e48\u642d\u7684\u3002</p>","tags":["\u5efa\u7ad9","\u968f\u7b14"]},{"location":"blog/2026/10/14/%E6%96%B0%E5%8D%9A%E5%AE%A2%E5%BB%BA%E7%AB%8B%E5%95%A6/#_2","title":"\u4e3a\u4ec0\u4e48\u8981\u5199\u535a\u5ba2","text":"<p>\u7406\u7531\u5927\u6982\u662f\u8fd9\u4e09\u4e2a\uff1a</p> <ol> <li>\u5199\u4e0b\u6765\u624d\u7b97\u771f\u7684\u61c2\u3002 \u4e00\u4e2a\u9898\u60f3\u901a\u4e86\u3001\u4e00\u4e2a trick \u8bb0\u4f4f\u4e86\uff0c\u5982\u679c\u4e0d\u5199\u4e0b\u6765\uff0c    \u8fc7\u4e24\u5468\u5c31\u53ea\u5269\u300c\u6211\u597d\u50cf\u89c1\u8fc7\u300d\u8fd9\u4e00\u5c42\u5370\u8c61\u3002</li> <li>\u7ed9\u81ea\u5df1\u7559\u6863\u3002 \u6563\u843d\u5728\u672c\u5730\u6587\u4ef6\u5939\u91cc\u7684 <code>.md</code>\u3001<code>.cpp</code>\u3001\u5bf9\u62cd\u811a\u672c\uff0c    \u8fdf\u65e9\u4f1a\u5728\u6362\u7535\u8111\u7684\u65f6\u5019\u4e22\u6389\u3002</li> <li>\u4e5f\u8bb8\u6709\u4eba\u770b\u3002 \u5982\u679c\u67d0\u7bc7\u63a8\u5bfc\u80fd\u8ba9\u53e6\u4e00\u4e2a\u4eba\u5c11\u5361\u4e24\u5c0f\u65f6\uff0c\u90a3\u4e5f\u633a\u597d\u3002</li> </ol>","tags":["\u5efa\u7ad9","\u968f\u7b14"]},{"location":"blog/2026/10/14/%E6%96%B0%E5%8D%9A%E5%AE%A2%E5%BB%BA%E7%AB%8B%E5%95%A6/#_3","title":"\u8fd9\u4e2a\u7ad9\u662f\u600e\u4e48\u642d\u7684","text":"<p>\u6280\u672f\u9009\u578b\u4e0a\u6284\u4e86\u51e0\u4f4d\u670b\u53cb\u7684\u4f5c\u4e1a\uff1a</p> <ul> <li>MkDocs Material\uff1aMarkdown \u5199\u4f5c\uff0c\u4fa7\u680f\u6811\u5f62\u5bfc\u822a\u9002\u5408\u653e\u7b97\u6cd5\u7b14\u8bb0\uff1b   \u641c\u7d22\u3001\u6df1\u8272\u6a21\u5f0f\u3001\u4ee3\u7801\u590d\u5236\u6309\u94ae\u90fd\u662f\u5185\u7f6e\u7684\u3002</li> <li>KaTeX\uff1a\u6570\u5b66\u516c\u5f0f\uff0c\u914d <code>pymdownx.arithmatex</code> \u4f7f\u7528\u3002</li> <li>GitHub Pages + GitHub Actions\uff1a<code>git push</code> \u4e4b\u540e\u81ea\u52a8\u6784\u5efa\u90e8\u7f72\u3002</li> <li>RSS\uff1a<code>/feed_rss_created.xml</code>\uff0c\u53ef\u4ee5\u76f4\u63a5\u4e22\u8fdb\u9605\u8bfb\u5668\u3002</li> </ul> <p>\u5199\u4f5c\u6d41\u7a0b\u5c31\u662f\uff1a</p> <pre><code>.\\scripts\\serve.ps1   # \u672c\u5730\u9884\u89c8 http://127.0.0.1:8000\ngit add -A\ngit commit -m \"post: \u65b0\u535a\u5ba2\u5efa\u7acb\u5566\"\ngit push              # 30 \u79d2\u540e\u7ebf\u4e0a\u66f4\u65b0\n</code></pre>","tags":["\u5efa\u7ad9","\u968f\u7b14"]},{"location":"blog/2026/10/14/%E6%96%B0%E5%8D%9A%E5%AE%A2%E5%BB%BA%E7%AB%8B%E5%95%A6/#_4","title":"\u63a5\u4e0b\u6765","text":"<p>\u5148\u628a\u672c\u5730\u79ef\u538b\u7684\u9898\u89e3\u642c\u8fc7\u6765\uff0c\u7136\u540e\u6162\u6162\u8865\u7b97\u6cd5\u7b14\u8bb0\u3002 \u5982\u679c\u54ea\u7bc7\u5199\u9519\u4e86\uff0c\u6b22\u8fce\u6765\u4fe1\u9a82\u6211\u3002</p>","tags":["\u5efa\u7ad9","\u968f\u7b14"]},{"location":"misc/","title":"\u6742\u9879","text":"<p>\u653e\u4e0d\u8fdb\u4e0a\u9762\u4efb\u4f55\u4e00\u7c7b\u7684\u4e1c\u897f\u3002</p> <ul> <li>\u6e38\u8bb0\uff08NOIP / CSP / \u96c6\u8bad / \u590f\u4ee4\u8425\uff09</li> <li>\u65e5\u8bb0</li> <li>\u5173\u4e8e\u5b66\u4e60\u3001\u5173\u4e8e\u751f\u6d3b\u7684\u4e00\u4e9b\u788e\u788e\u5ff5</li> </ul>"},{"location":"records/","title":"\u8bb0\u5f55","text":"<p>\u6309\u65f6\u95f4\u7ec4\u7ec7\u7684\u5237\u9898\u8bb0\u5f55\u3001\u96c6\u8bad\u603b\u7ed3\u3002</p>"},{"location":"records/#_2","title":"\u6309\u6708","text":"<ul> <li>2026 \u5e74 10 \u6708</li> </ul> <p>Tip</p> <p>\u4e00\u7c7b\u662f\u300c\u6742\u9898\u8bb0\u5f55\u300d\uff1a\u4e00\u6bb5\u65f6\u95f4\u7684\u9898\uff0c\u4e00\u53e5\u8bdd\u4e00\u53e5\u8bdd\u5730\u8bb0\u7ed3\u8bba\u548c trick\uff1b \u53e6\u4e00\u7c7b\u662f\u300c\u4e13\u9898\u8bb0\u5f55\u300d\uff1a\u67d0\u4e2a\u77e5\u8bc6\u70b9\u76f8\u5173\u7684\u9898\u96c6\u4e2d\u505a\u4e00\u904d\u3002</p>"},{"location":"solution/","title":"\u9898\u89e3","text":"<p>\u6309\u5e74\u4efd\u5f52\u6863\u3002\u5355\u7bc7\u6587\u7ae0\u91cc\u6211\u4f1a\u5c3d\u91cf\u5199\u6e05\u695a\uff1a\u601d\u8def\u4ece\u54ea\u6765\u3001\u4e3a\u4ec0\u4e48\u662f\u8fd9\u4e48\u62c6\u7684\u3001 \u4ee3\u7801\u5bf9\u5e94\u54ea\u4e00\u6b65\uff0c\u800c\u4e0d\u662f\u53ea\u8d34\u4e00\u4efd\u4ee3\u7801\u3002</p>"},{"location":"solution/#_2","title":"\u5e74\u4efd","text":"<ul> <li>2026 \u5e74</li> </ul> <p>\u6587\u4ef6\u547d\u540d\u5efa\u8bae</p> <ul> <li>Codeforces\uff1a<code>CF2274E.md</code></li> <li>\u6d1b\u8c37\uff1a<code>P10104.md</code></li> <li>\u6a21\u62df\u8d5b\uff1a<code>20261014-\u6a21\u62df\u8d5b-C.md</code></li> </ul> <p>\u653e\u8fdb <code>docs/solution/\u5e74\u4efd/</code> \u76ee\u5f55\uff0c\u7136\u540e\u5728 <code>mkdocs.yml</code> \u7684 <code>nav</code> \u91cc\u767b\u8bb0\u3002</p>"},{"location":"solution/2026/","title":"2026 \u5e74\u9898\u89e3","text":"<ul> <li>\u77f3\u5b50\u888b\u5b50 C \u00b7 \u574f\u72b6\u6001\u8ba1\u6570\u7684\u5b8c\u6574\u63a8\u5bfc</li> </ul>"},{"location":"solution/2026/stonebag-C/","title":"\u77f3\u5b50\u888b\u5b50 C \u00b7 \u574f\u72b6\u6001\u8ba1\u6570\u7684\u5b8c\u6574\u63a8\u5bfc","text":"<p>\u9898\u76ee\u8981\u8ba1\u6570\u7684\u662f\u53ef\u8fbe\u7684\u7ec8\u6001\u3002\u5b98\u65b9\u505a\u6cd5\u5206\u4e24\u6b65\uff1a\u5148\u6570\u300c\u603b\u6570\u300d\uff0c\u518d\u6263\u6389\u300c\u574f\u72b6\u6001\u300d\u3002</p> \\[\\#\\{\\,(b_1,\\dots,b_n)\\ \\big|\\ b_i\\ge 0,\\ {\\textstyle\\sum_i b_i\\le S}\\,\\}=\\binom{S+n}{n},\\] <p>\u4e0b\u9762\u628a\u574f\u72b6\u6001\u7684\u5b9a\u4e49\u3001\u6309 \\(d\\) \u7684\u62c6\u5206\uff0c\u4ee5\u53ca\u5b98\u65b9 <code>except()</code> / <code>irregular()</code> \u7684\u6765\u5386\u4ece\u5934\u5230\u5c3e\u5199\u6e05\u695a\u3002</p> \\[\\text{ans}=\\underbrace{\\binom{S+n}{n}}_{\\text{All}}-\\underbrace{\\text{Bad}}_{\\text{\u574f\u72b6\u6001\u6570}} .\\]","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#1-d","title":"1. \u574f\u72b6\u6001\u662f\u4ec0\u4e48\uff0c\u600e\u4e48\u6309 \\(d\\) \u62c6","text":"<p>\u53ef\u8fbe\u7684\u5145\u8981\u6761\u4ef6\u662f\u201c\u4e0d\u574f\u201d\uff0c\u800c\u574f\u72b6\u6001\u7684\u5b9a\u4e49\u662f\uff1a\u8bbe \\(d=S-\\sum_i b_i\\)\uff08\u888b\u4e2d\u5269\u7684\u77f3\u5b50\u6570\uff09\uff0c\u5219</p> \\[0\\le d\\le n-1,\\qquad \\max_i b_i\\le n-d-1,\\qquad \\exists i:\\ b_i&gt;a_i .\\] <p>\u5bf9\u6bcf\u4e2a\u56fa\u5b9a\u7684 \\(d\\) \u8bb0 $\\(M=n-d-1,\\qquad T=S-d .\\)$ \u5219\u7b2c \\(d\\) \u7c7b\u7684\u574f\u72b6\u6001\u4e3a $\\(\\text{Bad}_d=\\Big\\{\\,b:\\ 0\\le b_i\\le M,\\ \\sum_i b_i=T,\\ \\exists i:\\ b_i&gt;a_i\\,\\Big\\}.\\)$</p> <p>\u5173\u952e\uff1a\u5bf9\u4efb\u610f\u4e00\u4e2a\u7ec8\u6001 \\(b\\)\uff0c\\(d=S-\\sum b_i\\) \u7531 \\(b\\) \u552f\u4e00\u786e\u5b9a\uff0c\u6240\u4ee5\u4e0d\u540c\u7684 \\(d\\) \u5bf9\u5e94\u7684 \\(\\text{Bad}_d\\) \u4e24\u4e24\u4e0d\u4ea4\uff0c</p> \\[\\text{Bad}=\\sum_{d=0}^{n-1}\\text{Bad}_d .\\] <p>\u518d\u628a\u201c\u5b58\u5728 \\(b_i&gt;a_i\\)\u201d\u7528\u8865\u96c6\u5199\uff1a</p> \\[\\text{Bad}_d=\\underbrace{\\#\\{0\\le b_i\\le M,\\ \\textstyle\\sum b_i=T\\}}_{U_d}\\;-\\;\\underbrace{\\#\\{0\\le b_i\\le\\min(a_i,M),\\ \\textstyle\\sum b_i=T\\}}_{V_d}.\\] <ul> <li>\\(U_d\\)\uff1a\u7edf\u4e00\u4e0a\u754c \\(M\\)\uff0c\u597d\u7b97\uff1b</li> <li>\\(V_d\\)\uff1a\u9010\u5806\u4e0a\u754c \\(\\min(a_i,M)\\)\uff0c\u662f\u552f\u4e00\u7684\u96be\u70b9\u3002</li> </ul>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#2-u_d","title":"2. \\(U_d\\)\uff1a\u6807\u51c6\u5bb9\u65a5","text":"<p>\u5148\u4e0d\u7ba1\u4e0a\u754c\uff0c\\(b_1+\\dots+b_n=T\\) \u7684\u975e\u8d1f\u89e3\u6570\u662f \\(\\binom{T+n-1}{n-1}\\)\u3002\u6263\u6389\u201c\u6709\u5806\u8d85\u8fc7 \\(M\\)\u201d\u7684\uff0c\u7528\u5bb9\u65a5\uff1a</p> <ul> <li>\u9009\u51fa \\(i\\) \u5806\u5f3a\u5236 \\(b_j\\ge M+1\\)\uff0c\u4ee4 \\(b_j'=b_j-(M+1)\\ge0\\)\uff0c\u5269\u4f59\u548c\u4e3a \\(T-i(M+1)\\)\uff1b</li> <li>\u8fd9\u4e00\u6b65\u7684\u65b9\u6848\u6570\u662f \\(\\binom{T-i(M+1)+n-1}{n-1}\\)\u3002</li> </ul> <p>\u4e8e\u662f $\\(\\boxed{\\,U_d=\\sum_{i\\ge0}(-1)^i\\binom{n}{i}\\binom{T-i(M+1)+n-1}{n-1}\\,}\\)$ \u4ee3\u5165 \\(M+1=n-d,\\ T=S-d\\)\uff1a $\\(U_d=\\sum_{i\\ge0}(-1)^i\\binom{n}{i}\\binom{S-d-i(n-d)+n-1}{n-1}.\\)$ \u6bcf\u4e2a \\(d\\) \u662f \\(O(n)\\)\uff0c\u5168\u90e8 \\(d\\) \u662f \\(O(n^2)\\)\u3002\u8fd9\u5c31\u662f\u5b98\u65b9 <code>except()</code>\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#3-v_d","title":"3. \\(V_d\\)\uff1a\u9010\u5806\u4e0a\u754c\u7684\u7ec4\u5408\u6570","text":"<p>\u8bbe \\(c_i=\\min(a_i,M)\\)\uff0c\u5219 $\\(V_d=\\#\\{0\\le b_i\\le c_i,\\ \\textstyle\\sum b_i=T\\}=[x^{T}]\\,\\prod_{i=1}^{n}\\bigl(1+x+\\dots+x^{c_i}\\bigr).\\)$ \uff08\u5199\u6210\u7cfb\u6570\u5f62\u5f0f\u662f\u8bb0\u53f7\u65b9\u4fbf\uff1b\u771f\u6b63\u5b9e\u73b0\u662f\u5bb9\u65a5/DP\uff0c\u89c1\u4e0b\u3002\uff09</p> <p>\u76f4\u63a5\u5c55\u5f00\u5c31\u662f\u6309\u201c\u54ea\u4e9b\u5806\u7a81\u7834\u4e0a\u754c\u201d\u5bb9\u65a5\uff1a $\\(V_d=\\sum_{Y\\subseteq[n]}(-1)^{|Y|}\\binom{T-\\sum_{j\\in Y}(c_j+1)+n-1}{n-1}.\\)$ \u5b50\u96c6\u6709 \\(2^n\\) \u4e2a\uff0c\u4e0d\u80fd\u76f4\u63a5\u679a\u4e3e\uff1b\u4f46\u628a\u76f8\u540c\u7684 \\(c_j+1\\) \u5408\u5e76\u3001\u7528\u4e00\u4e2a\u591a\u9879\u5f0f\u7ef4\u62a4\u5373\u53ef\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#31-n","title":"3.1 \u5173\u952e\uff1a\u6362\u6210\u201c\u4e8f\u7a7a\u201d\u540e\u53ea\u9700\u770b\u6700\u4f4e \\(n\\) \u6b21\u9879","text":"<p>\u4ee4 \\(z_i=c_i-b_i\\)\uff0c\u5219 \\(0\\le z_i\\le c_i\\)\uff0c\u4e14 $\\(\\sum_i z_i=\\sum_i c_i-T .\\)$ \u8bb0 $\\(\\operatorname{off}\\;:=\\;S-\\sum_i c_i\\qquad(\\text{\u201c\u88ab\u780d\u6389\u7684\u603b\u4e0a\u754c\u201d}),\\)$ \u5219 $\\(\\sum_i z_i=\\sum_i c_i-T=(S-\\operatorname{off})-(S-d)=d-\\operatorname{off}.\\)$ \u6240\u4ee5 $\\(\\boxed{\\,V_d=[x^{\\,d-\\operatorname{off}}]\\,P(x),\\qquad P(x)=\\prod_{i=1}^{n}\\bigl(1+x+\\dots+x^{c_i}\\bigr)\\,}\\)$</p> <p>\u6ce8\u610f\uff1a</p> <ul> <li>\u82e5 \\(d&lt;\\operatorname{off}\\)\uff0c\u6307\u6570 \\(d-\\operatorname{off}&lt;0\\)\uff0c\u5219 \\(V_d=0\\)\uff1b</li> <li>\\(d\\le n-1\\)\uff0c\u6240\u4ee5\u771f\u6b63\u8981\u7528\u7684\u6307\u6570\u6c38\u8fdc\u4e0d\u8d85\u8fc7 \\(n-1\\)\uff1b</li> <li>\u82e5 \\(\\operatorname{off}&gt;n-1\\)\uff0c\u5219\u6240\u6709 \\(d\\le n-1\\) \u90fd\u6709 \\(V_d=0\\)\uff0c\u76f4\u63a5\u8df3\u8fc7\u8fd9\u90e8\u5206\u5373\u53ef\u3002</li> </ul> <p>\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u5b98\u65b9\u5b9e\u73b0\u91cc \\(P\\) \u53ea\u662f\u4e00\u6761\u957f\u5ea6 \\(n+1\\) \u7684\u6570\u7ec4\uff0c\u5b8c\u5168\u4e0d\u9700\u8981\u5bf9\u5de8\u5927\u7684 \\(T\\)\uff08\u53ef\u8fbe \\(O(n^2)\\)\uff09\u505a DP\uff0c\u4e5f\u4e0d\u9700\u8981 FFT\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#32-d-p","title":"3.2 \u968f \\(d\\) \u589e\u91cf\u7ef4\u62a4 \\(P\\)","text":"<p>\\(d\\) \u6bcf\u589e\u52a0 1\uff0c\\(M=n-d-1\\) \u51cf 1\uff0c\u4e8e\u662f\u6bcf\u4e2a $\\(c_i=\\min(a_i,\\ n-d-1)\\)$ \u53ea\u53ef\u80fd\u53d8\u5c0f\uff0c\u800c\u4e14\u6bcf\u6b21\u53ea\u5c0f 1\u3002\u5f53\u67d0\u5806\u7684\u4e0a\u754c\u4ece \\(c\\) \u964d\u5230 \\(c-1\\) \u65f6\uff0c\u591a\u9879\u5f0f\u56e0\u5b50 $\\(1+x+\\dots+x^{c}\\ \\longrightarrow\\ 1+x+\\dots+x^{c-1}\\)$ \u53ea\u9700\u4e58\u4e00\u4e2a\u6bd4\u503c\uff1a $\\(\\frac{1-x^{c}}{1-x^{c+1}}.\\)$ \u5728\u6570\u7ec4\u4e0a\u7528\u524d\u7f00\u5dee\u5206\u5b9e\u73b0\uff0c\u4e00\u6b21\u64cd\u4f5c \\(O(n)\\)\uff1a</p> <ul> <li>\u4e58 \\(1/(1-x^{k})\\)\uff1a<code>for i=k..n: dp[i]+=dp[i-k]</code>\uff1b</li> <li>\u4e58 \\((1-x^{k})\\)\uff1a<code>for i=n..k: dp[i]-=dp[i-k]</code>\u3002</li> </ul> <p>\u6bcf\u5806\u7684\u4e0a\u754c\u4e00\u5171\u6700\u591a\u964d \\(\\le n\\) \u6b21\uff0c\u6240\u4ee5\u603b\u66f4\u65b0\u6b21\u6570 \\(O(n^2)\\) \u91cf\u7ea7\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#33","title":"3.3 \u5b83\u548c\u5b98\u65b9\u4ee3\u7801\u7684\u5bf9\u5e94","text":"<ul> <li><code>P</code> \u5c31\u662f\u90a3\u4e2a <code>dp[]</code>\uff08\u622a\u65ad\u5230 \\(x^n\\)\uff09\uff1b</li> <li>\\(\\operatorname{off}=S-\\sum c_i\\) \u5c31\u662f\u4ee3\u7801\u91cc\u7684 <code>off</code>\uff08\u5bf9 \\(a_i&gt;n\\) \u7684\u5806\u5148\u8bb0\u5165\uff0c\u4e4b\u540e\u6bcf\u964d\u4e00\u683c\u518d <code>++off</code>\uff09\uff1b</li> <li>\u9700\u8981\u53d6\u7684\u7cfb\u6570\u662f \\(d-\\operatorname{off}\\)\uff0c\u5373\u4ee3\u7801\u91cc\u7684 <code>dp[d-off]</code>\uff08\u6761\u4ef6 <code>d&gt;=off</code> \u5bf9\u5e94\u6307\u6570\u975e\u8d1f\uff09\uff1b</li> <li><code>except()</code> \u7d2f\u52a0\u7684\u662f \\(\\sum_d U_d\\)\uff0c<code>irregular()</code> \u7d2f\u52a0\u7684\u662f \\(\\sum_d V_d\\)\uff1b</li> <li>\u6700\u540e <code>all - except + irregular</code> \u5c31\u662f \\(\\binom{S+n}{n}-\\sum_d(U_d-V_d)\\)\u3002</li> </ul>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#4","title":"4. \u4e00\u4e2a\u5c0f\u4f8b\u5b50\u9a8c\u8bc1","text":"<p>\u53d6 \\(n=3,\\ a=(2,1,3)\\)\uff0c\u5219 \\(S=6\\)\u3002</p> <ul> <li>\\(\\text{All}=\\binom{6+3}{3}=\\binom{9}{3}=84\\)\u3002</li> <li>\\(d=0\\)\uff1a\\(M=2,\\ T=6\\)\u3002<ul> <li>\\(U_0\\)\uff1a\\(b_i\\le2\\) \u4e14\u548c\u4e3a 6\uff0c\u53ea\u6709 \\((2,2,2)\\)\uff0c\u6545 \\(U_0=1\\)\u3002</li> <li>\\(V_0\\)\uff1a\\(c=\\min(a,2)=(2,1,2)\\)\uff0c\u4e0a\u754c\u548c \\(=5&lt;6\\)\uff0c\u6545 \\(V_0=0\\)\u3002</li> <li>\\(\\text{Bad}_0=1\\)\u3002</li> </ul> </li> <li>\\(d=1\\)\uff1a\\(M=1,T=5\\)\uff0c\u6700\u5927\u548c \\(3&lt;5\\)\uff0c\\(U_1=V_1=0\\)\u3002</li> <li>\\(d=2\\)\uff1a\\(M=0,T=4\\)\uff0c\\(0\\)\u3002</li> </ul> <p>\u4e8e\u662f \\(\\text{Bad}=1\\)\uff0c\u7b54\u6848 \\(=84-1=83\\)\uff0c\u4e0e\u6837\u4f8b\u4e00\u81f4\u3002\u552f\u4e00\u4e0d\u53ef\u8fbe\u7684\u6b63\u662f \\(b=(2,2,2)\\)\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#5","title":"5. \u590d\u6742\u5ea6","text":"<ul> <li>\u9884\u5904\u7406 \\(\\binom{\\cdot}{\\cdot}\\)\uff1a\u9636\u4e58\u5230 \\(O(n^2)\\) \u7ea7\u522b\u5373\u53ef\uff08\u56e0\u4e3a\u53ea\u9700\u5728 \\(S\\le n(n-1)\\) \u65f6\u8ba1\u7b97\uff09\uff1b</li> <li>\\(U_d\\) \u7d2f\u52a0\uff1a\\(O(n^2)\\)\uff1b</li> <li>\\(V_d\\) \u7684\u6570\u7ec4 DP\uff1a\u6bcf\u6b21\u56e0\u5b50\u66f4\u65b0 \\(O(n)\\)\uff0c\u603b\u66f4\u65b0 \\(O(n^2)\\)\uff0c\u6240\u4ee5 \\(O(n^2)\\)\uff1b</li> <li>\u82e5 \\(S&gt;n(n-1)\\)\uff1a\u574f\u72b6\u6001\u4e3a\u7a7a\uff0c\u7b54\u6848\u76f4\u63a5 \\(\\binom{S+n}{n}\\)\uff0c\\(O(n)\\)\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd\uff1a\u574f\u72b6\u6001\u6309 \\(d\\) \u62c6\u5f00\uff1b\\(U_d\\) \u7528\u4e8c\u9879\u5f0f\u5bb9\u65a5\uff1b\\(V_d\\) \u628a\u201c\u9010\u5806\u4e0a\u754c\u201d\u6362\u6210\u4e8f\u7a7a \\(z_i=c_i-b_i\\) \u540e\uff0c\u53ea\u9700\u591a\u9879\u5f0f\u6700\u4f4e \\(n\\) \u6b21\u7684\u7cfb\u6570\uff0c\u7528\u957f\u5ea6 \\(n+1\\) \u7684\u6570\u7ec4\u968f \\(d\\) \u589e\u91cf\u66f4\u65b0\u5373\u53ef\u2014\u2014\u8fd9\u5c31\u662f\u5168\u90e8\u201c\u574f\u72b6\u6001\u8ba1\u6570\u201d\uff0c\u6ca1\u6709\u4efb\u4f55\u9ad8\u9636\u751f\u6210\u51fd\u6570\u8fd0\u7b97\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"solution/2026/stonebag-C/#_1","title":"\u53c2\u8003\u4ee3\u7801","text":"stonebag_C.cpp<pre><code>// \u89c1\u9898\u76ee\u5b98\u65b9 except() / irregular() \u5b9e\u73b0\n</code></pre> <p>\u5f85\u8865</p> <p>\u8fd9\u91cc\u628a\u6211\u672c\u5730\u90a3\u4efd <code>stonebag_C_AC.cpp</code> \u8d34\u4e0a\u6765\uff0c\u5e76\u9010\u884c\u5bf9\u5e94\u4e0a\u9762\u7684 \\(U_d\\) / \\(V_d\\)\u3002</p>","tags":["\u9898\u89e3","\u7ec4\u5408\u6570\u5b66","\u5bb9\u65a5","\u751f\u6210\u51fd\u6570"]},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/%E6%9D%82%E8%B0%88/","title":"\u6742\u8c08","text":""}]}